DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

PORT=4000

# External API keys (optional, add later)
OPENWEATHER_API_KEY=""
IQAIR_API_KEY=""

# Google Places API (optional, for real gyms/parks from Google Maps)
GOOGLE_MAPS_API_KEY=""

# SerpApi (optional, alternative Google Maps local results provider)
SERPAPI_API_KEY=""

# YouTube Data API (optional, for indoor video search)
YOUTUBE_API_KEY=""

# SMTP (optional, for forgot-password emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FitAir <no-reply@yourdomain.com>"
