generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SpotType {
  indoor
  outdoor
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  location     String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sports            UserSport[]
  reviews           SpotReview[]
  schedules         Schedule[]
  posts             CommunityPost[]
  postParticipants  PostParticipant[]
  comments          PostComment[]
  postLikes         PostLike[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  passwordResets    PasswordReset[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model UserSport {
  id     String @id @default(cuid())
  userId String
  sport  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sport])
}

model Spot {
  id                String    @id @default(cuid())
  name              String
  address           String
  district          String?
  lat               Float
  lng               Float
  type              SpotType
  source            String? // demo | serpapi | google | manual
  sourceRefreshedAt DateTime?
  price             String?
  hours             String?
  facilities        String[]  @default([])
  sports            String[]  @default([])
  imageUrls         String[]  @default([])
  avgRating         Float     @default(0)
  reviewCount       Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reviews SpotReview[]

  @@index([source, sourceRefreshedAt])
}

model SpotReview {
  id        String   @id @default(cuid())
  spotId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spotId])
  @@index([userId])
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String
  date      DateTime
  time      String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders ScheduleReminder[]

  @@index([userId])
}

model CommunityPost {
  id              String   @id @default(cuid())
  userId          String
  content         String
  sport           String?
  location        String?
  time            String?
  maxParticipants Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants PostParticipant[]
  comments     PostComment[]
  likes        PostLike[]
}

model PostParticipant {
  id       String   @id @default(cuid())
  postId   String
  userId   String
  joinedAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model IndoorVideo {
  id          String   @id @default(cuid())
  titleJp     String
  titleVn     String?
  youtubeUrl  String
  duration    String?
  category    String?
  level       String?
  calories    Int?
  instructor  String?
  description String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model ScheduleReminder {
  id             String   @id @default(cuid())
  scheduleId     String
  scheduledAt    DateTime
  notificationId String?
  createdAt      DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledAt])
  @@index([scheduledAt])
}
